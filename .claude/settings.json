{
  "model": "sonnet",
  "advisorModel": "fable",
  "extraKnownMarketplaces": {
    "googlechrome": {
      "source": {
        "source": "github",
        "repo": "GoogleChrome/modern-web-guidance"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "python .claude/hooks/proteger_git.py"}]
      }
    ]
  },
  "enabledPlugins": {
    "modern-web-guidance@googlechrome": true
  }
}
